{
  "sum_project": 1,
  "name": "sumgui-button",
  "version": "0.1.0",
  "language": "python",
  "entrypoint": "main.py",
  "sources": ["main.py"],
  "resources": [],
  "dependencies": ["sumgui", "sumui"],
  "interface": {
    "backend": "sumgui",
    "orientation": "auto",
    "screen": "auto",
    "keyboard": {
      "system": true,
      "accessory": "auto",
      "show_hide": true
    },
    "shortcuts": {
      "exit": "F10",
      "fullscreen": "ALT+ENTER"
    }
  },
  "build": {
    "targets": ["host", "android"],
    "console": false,
    "host": {"backend": "auto"},
    "android": {
      "backend": "p4a",
      "transpile": "sumgui-easy",
      "requirements": ["python3", "sdl2"],
      "arch": "arm64-v8a",
      "mode": "debug",
      "package_domain": "org.sumecosystem",
      "api": 33,
      "ndk_api": 24
    }
  }
}
