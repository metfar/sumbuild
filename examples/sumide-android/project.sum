{
  "sum_project": 1,
  "name": "sumide",
  "version": "0.1.0",
  "language": "python",
  "entrypoint": "main.py",
  "sources": [
    "main.py"
  ],
  "resources": [],
  "dependencies": [
    "sumide"
  ],
  "interface": {
    "backend": "sumgui",
    "orientation": "auto",
    "font_size": "auto",
    "font_auto": {
      "ideal_columns": 72,
      "min_columns": 40,
      "portrait_columns": 72,
      "landscape_columns": 80,
      "min_rows_keyboard": 15,
      "min_px": 18,
      "max_px": 64
    },
    "icon": "sum",
    "exit_button": "auto",
    "keyboard": {
      "system": true,
      "show_button": "auto",
      "accessory": "keybar",
      "profile": "keybar",
      "show_hide": true,
      "reserve": "auto",
      "accessory_button_height": "auto",
      "accessory_arrow_style": "spectrum",
      "accessory_bold": true,
      "repeat": {
        "enabled": true,
        "delay_ms": 400,
        "interval_ms": 55
      }
    },
    "shortcuts": {
      "exit": "F10",
      "fullscreen": "ALT+ENTER"
    }
  },
  "build": {
    "targets": [
      "android"
    ],
    "console": false,
    "android": {
      "backend": "p4a",
      "runtime": "sumide",
      "storage_access": "all-files",
      "api": 33,
      "ndk_api": 24,
      "arch": "arm64-v8a",
      "requirements": [
        "python3",
        "sdl2",
        "rich",
        "pygments",
        "markdown-it-py",
        "mdurl",
        "Markdown",
        "markdownify"
      ]
    }
  }
}
