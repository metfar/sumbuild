{
  "schema_version": 1,
  "title": "sumedit Help",
  "intro": "Topic-oriented help for sumedit and EditApp-derived IDEs.",
  "topics": [
    {
      "name": "Keyboard",
      "category": "Editor",
      "summary": "Keyboard navigation, editing and application shortcuts.",
      "syntax": [
        "F1  Help",
        "F2 / Alt+P  Program/document map",
        "F3  Find next",
        "F9  Menu",
        "F10 / Ctrl+Q  Exit",
        "Ctrl+S  Save",
        "Ctrl+O  Open",
        "Ctrl+W  Close document",
        "Ctrl+Tab  Next document",
        "Ctrl+Z / Ctrl+Y  Undo / Redo",
        "Ctrl+C / Ctrl+X / Ctrl+V  Copy / Cut / Paste",
        "Shift + movement  Extend selection",
        "Tab / Shift+Tab  Indent / unindent"
      ],
      "example": "Use Ctrl+F to find text, F3 to continue forward and Shift+F3 to search backward.",
      "notes": [
        "Alt+F/E/S/V/O/I/H opens File/Edit/Search/View/Options/Window/Help.",
        "Current shortcuts has the effective bindings after user overrides."
      ],
      "see_also": [
        "Current shortcuts",
        "Windows"
      ],
      "aliases": [
        "keys",
        "shortcuts"
      ],
      "language": "text"
    },
    {
      "name": "Mouse",
      "category": "Editor",
      "summary": "Pointer behavior in terminals with SGR mouse reporting.",
      "syntax": [
        "Left click  Place caret or focus control",
        "Left drag  Extend selection",
        "Wheel  Scroll vertically",
        "Scrollbar click/drag  Page or move thumb"
      ],
      "example": "Click in the editor, then drag while holding the left button to extend the selection.",
      "notes": [
        "Mouse support depends on the frontend/terminal reporting pointer events."
      ],
      "see_also": [
        "Windows"
      ],
      "aliases": [
        "pointer"
      ],
      "language": "text"
    },
    {
      "name": "Search and replace",
      "category": "Editing",
      "summary": "Find, replace and go-to-line operations.",
      "syntax": [
        "Ctrl+F  Find",
        "F3  Find next",
        "Shift+F3  Find previous",
        "Ctrl+H  Search and replace",
        "Ctrl+G  Go to line"
      ],
      "example": "Enable regular expression in the Find dialog when the search text should be interpreted as a regex.",
      "notes": [
        "Case sensitive, whole word, regular expression and wrap-around are optional."
      ],
      "see_also": [
        "Keyboard"
      ],
      "aliases": [
        "find",
        "replace",
        "regex"
      ],
      "language": "text"
    },
    {
      "name": "View markers",
      "category": "Viewing",
      "summary": "Display spaces, tabs, line endings and control characters explicitly.",
      "syntax": [
        "·  space",
        "⇥  tab",
        "↵  LF",
        "⏎  CRLF",
        "↩  CR",
        "␀…␟, ␡  control characters"
      ],
      "example": "Use View > Show line endings when checking mixed-EOL files.",
      "notes": [
        "View checkboxes can be toggled with Space.",
        "Syntax highlighting is auto-detected from the filename when possible."
      ],
      "see_also": [
        "Line wrapping and breaking"
      ],
      "aliases": [
        "whitespace",
        "eol",
        "control characters"
      ],
      "language": "text"
    },
    {
      "name": "Character Chart",
      "category": "Tools",
      "summary": "Insert extended ASC-H, Unicode scientific, mathematical and graphic characters.",
      "syntax": [
        "Window > Character Chart...",
        "Ctrl+Alt+C  Open Character Chart",
        "Enter / Space  Insert selected symbol",
        "PgUp / PgDn  Change ASC-H page",
        "U+2192  Lookup Unicode code point"
      ],
      "example": "Open Character Chart, search U+2192, then insert → at the caret.",
      "notes": [
        "Reserved BASIC command/token positions remain non-insertable.",
        "The dialog stays open after insertion so several symbols can be entered."
      ],
      "see_also": [
        "Keyboard"
      ],
      "aliases": [
        "ascii chart",
        "asc-h",
        "unicode",
        "symbols",
        "math"
      ],
      "language": "text"
    },
    {
      "name": "Windows",
      "category": "Workspace",
      "summary": "Navigate, move, resize and restore editor/IDE workspace windows.",
      "syntax": [
        "F6 / Ctrl+Tab  Next window/work area",
        "F11 / Alt+Enter  Maximize/restore",
        "Alt+M  Move",
        "Alt+Z  Resize",
        "Ctrl+F4  Close workspace window",
        "Window > Reset Window Layout"
      ],
      "example": "Press Alt+M, use arrows to move the active workspace window, then Enter to accept.",
      "notes": [
        "Character Chart is in the Window menu while sumedit has no Insert menu."
      ],
      "see_also": [
        "Character Chart",
        "Keyboard"
      ],
      "aliases": [
        "workspace",
        "window menu"
      ],
      "language": "text"
    },
    {
      "name": "Themes",
      "category": "Configuration",
      "summary": "Select persistent editor color schemes and manage themes with sumtheme.",
      "syntax": [
        "Options > Theme  Select editor theme",
        "sumtheme --list  List themes",
        "sumtheme --search dark  Search themes"
      ],
      "example": "Select Yaru Dark after importing it with sumtheme.",
      "notes": [
        "ZX is the fresh-install sumedit default.",
        "Theme import/export is managed by sumtheme."
      ],
      "see_also": [
        "Configuration"
      ],
      "aliases": [
        "colors",
        "sumtheme"
      ],
      "language": "text"
    },
    {
      "name": "Line wrapping and breaking",
      "category": "Editing",
      "summary": "Control visual wrapping separately from modifications to the document text.",
      "syntax": [
        "Wrapping -1  Automatic to editor width",
        "Wrapping 0  Disabled",
        "Wrapping N  Visual maximum width",
        "Breaking 0  Disabled",
        "Breaking N  Insert hard line breaks"
      ],
      "example": "Use line wrapping 78 for a legacy 80-column window without changing the file.",
      "notes": [
        "Line wrapping is visual only.",
        "Line breaking changes text and is therefore intentionally separate."
      ],
      "see_also": [
        "Configuration",
        "View markers"
      ],
      "aliases": [
        "wrap",
        "hard break"
      ],
      "language": "text"
    },
    {
      "name": "Configuration",
      "category": "Configuration",
      "summary": "Configure tab widths, syntax, wrapping, themes, preferences and keyboard shortcuts.",
      "syntax": [
        "Options > Tab",
        "Options > Theme",
        "Options > Line wrapping",
        "Options > Line breaking",
        "Options > Keyboard shortcuts...",
        "Options > Preferences...",
        "Options > Save configuration"
      ],
      "example": "Change a keyboard binding and use Save configuration to preserve it for future sessions.",
      "notes": [
        "Tabs → Spaces and Spaces → Tabs use the current Tab width.",
        "Markdown files provide rendered preview plus HTML/PDF export."
      ],
      "see_also": [
        "Themes",
        "Line wrapping and breaking",
        "Current shortcuts"
      ],
      "aliases": [
        "preferences",
        "options"
      ],
      "language": "text"
    }
  ]
}
